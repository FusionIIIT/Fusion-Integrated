+        elif action == 'post' and isinstance(view, EstablishmentRouteView):
+            return HasModuleGrant("leave") and HasPermission("leave.request.assign")(request)
+        elif action == 'post' and isinstance(view, SanctionActionView):
+            return HasModuleGrant("leave") and HasPermission("leave.request.approve")(request)
+        elif action == 'post' and isinstance(view, WithdrawRequestView):
+            return HasModuleGrant("leave") and HasPermission("leave.request.delete")(request)
+        elif action == 'post' and isinstance(view, ResumptionActionView):
+            sub_action = request.data.get("action")
+            if sub_action == "SUBMIT":
+                return HasModuleGrant("leave") and HasPermission("leave.resumption.create")(request)
+            elif sub_action == "REVIEW":
+                return HasModuleGrant("leave") and HasPermission("leave.resumption.review")(request)
+        return False
