      "id": "UC-001",
      "title": "Submit Complaint",
      "description": "A complainant (student/faculty/staff) creates a new complaint.",
      "type": "derived",
      "source": "Page 2 – Core Objectives (complaint submission)",
      "steps": [
        "Authenticate as complainant",
        "POST /api/v1/complaints/ with required fields",
        "System creates complaint with status 'submitted' and unique identifier"
      ],
      "scenarios": [
        {
          "name": "Happy path",
          "preconditions": "Authenticated complainant",
          "test_data": {
            "category": "Electrical",
            "location": "Building A",
            "description": "Power outage"
          },
          "expected": "Not specified (status not documented)"
        },
        {
          "name": "Missing fields",
          "preconditions": "Authenticated complainant",
          "test_data": {
            "category": "Electrical"
          },
          "expected": "Not specified (status not documented)"
        },
        {
          "name": "Unauthenticated",
          "preconditions": "No authentication token",
          "expected": "Not specified (status not documented)"
        }
      ]
    },
