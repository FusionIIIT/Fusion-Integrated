      "id": "FR-001",
      "description": "Allow a complainant (student, faculty, or staff) to submit a new complaint via POST /api/v1/complaints/. Required permission: complaints.complaint.create.",
      "type": "explicit",
      "source": "Page 2 – Core Objectives (complaint submission)",
      "scenarios": [
        {
          "name": "Positive submission",
          "preconditions": "Authenticated user with role student/faculty/staff",
          "test_data": {
            "category": "Electrical",
            "location": "Building A",
            "description": "Power outage in lab"
          },
          "expected": "Not specified (status not documented)"
        },
        {
          "name": "Negative – unauthenticated",
          "preconditions": "No authentication token",
          "expected": "Not specified (status not documented)"
        },
        {
          "name": "Negative – missing required fields",
          "preconditions": "Authenticated user",
          "test_data": {
            "category": "Electrical"
          },
          "expected": "Not specified (status not documented)"
        }
      ]
    },
