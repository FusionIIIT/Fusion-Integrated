To integrate the Employee Leave Management (ELM) module into the existing Fusion ERP system, we need to follow a structured approach. We'll start by setting up the backend and frontend components as per the provided specifications.

### Step 1: Set Up the Backend

#### Create the ELM Module Directory

First, create the necessary directory structure for the ELM module:

```bash
mkdir -p modules/elm
```

#### Define Models

Create a `models.py` file in the `modules/elm` directory to define the data models:

```python
# modules/elm/models.py
from django.db import models
from fusion_auth.models import Principal

class LeaveBalance(models.Model):
    user = models.ForeignKey(Principal, on_delete=models.CASCADE)
    leave_type = models.CharField(max_length=10)  # CL, RH, SCL, EL, VL, COL
    balance = models.IntegerField()

class LeaveApplication(models.Model):
    STATUS_CHOICES = [
        ('draft', 'Draft'),
        ('pending_unit_head', 'Pending Unit Head Approval'),
        ('pending_establishment', 'Pending Establishment Approval'),
        ('pending_authority', 'Pending Authority Approval'),
        ('approved', 'Approved'),
        ('cancelled', 'Cancelled'),
        ('rejected', 'Rejected'),
    ]
    user = models.ForeignKey(Principal, on_delete=models.CASCADE)
    leave_type = models.CharField(max_length=10)  # CL, RH, SCL, EL, VL, COL
    start_date = models.DateField()
    end_date = models.DateField()
    status = models.CharField(max_length=20, choices=STATUS_CHOICES, default='draft')
    station_leave = models.BooleanField(default=False)

class SubstituteRequest(models.Model):
    leave_application = models.ForeignKey(LeaveApplication, on_delete=models.CASCADE)
    substitute_user = models.ForeignKey(Principal, on_delete=models.CASCADE)
    approved = models.BooleanField(default=False)

class HolidayCalendar(models.Model):
    date = models.DateField()
    description = models.CharField(max_length=255)

class LeavePolicy(models.Model)
    leave_type = models.CharField(max_length=10)  # CL, RH, SCL, EL, VL, COL
    max_days = models.IntegerField()
```

#### Define Services

Create a `services.py` file to define the business logic:

```python
# modules/elm/services.py
from .models import LeaveApplication, SubstituteRequest, LeaveBalance

def apply_leave(user, leave_type, start_date, end_date, station_leave=False):
    leave_application = LeaveApplication.objects.create(
        user=user,
        leave_type=leave_type,
        start_date=start_date,
        end_date=end_date,
        station_leave=station_leave
    )
    return leave_application

def approve_leave(leave_application):
    if leave_application.status == 'pending_unit_head':
        leave_application.status = 'approved'
        leave_application.save()
    elif leave_application.status == 'pending_establishment':
        leave_application.status = 'approved'
        leave_application.save()
    elif leave_application.status == 'pending_authority':
        leave_application.status = 'approved'
        leave_application.save()

def cancel_leave(leave_application):
    if leave_application.status in ['draft', 'pending_unit_head']:
        leave_application.status = 'cancelled'
        leave_application.save()

def request_substitute(leave_application, substitute_user):
    SubstituteRequest.objects.create(
        leave_application=leave_application,
        substitute_user=substitute_user
    )

def approve_substitute(substitute_request):
    if not substitute_request.approved:
        substitute_request.approved = True
        substitute_request.save()
```

#### Define API Endpoints

Create a `views.py` file to define the API endpoints:

```python
# modules/elm/views.py
from rest_framework import viewsets, status
from rest_framework.response import Response
from .models import LeaveApplication, SubstituteRequest
from .serializers import LeaveApplicationSerializer, SubstituteRequestSerializer

class LeaveApplicationViewSet(viewsets.ModelViewSet):
    queryset = LeaveApplication.objects.all()
    serializer_class = LeaveApplicationSerializer

class SubstituteRequestViewSet(viewsets.ModelViewSet):
    queryset = SubstituteRequest.objects.all()
    serializer_class = SubstituteRequestSerializer
```

Create a `serializers.py` file to define the serializers:

```python
# modules/elm/serializers.py
from rest_framework import serializers
from .models import LeaveApplication, SubstituteRequest

class LeaveApplicationSerializer(serializers.ModelSerializer):
    class Meta:
        model = LeaveApplication
        fields = '__all__'

class SubstituteRequestSerializer(serializers.ModelSerializer):
    class Meta:
        model = SubstituteRequest
        fields = '__all__'
```

#### Define Migrations

Create a `migrations` directory and generate the initial migration:

```bash
python manage.py makemigrations elm
```

Edit the generated migration file to create the necessary tables.

#### Register Module in Fusion ERP

Update `config/settings/base.py` to include the ELM module:

```python
INSTALLED_APPS = (DJANGO_APPS + THIRD_PARTY_APPS + LOCAL_APPS
                  + PLATFORM_MODULES + DOMAIN_MODULES + ["modules.elm"])
```

Mount URLs in `config/urls.py`:

```python
urlpatterns = [
    path("api/v1/", include("fusion_auth.urls")),
    path("api/v1/directory/", include("modules.directory.api.urls")),
    path("api/v1/placement/", include("modules.placement.api.urls")),
    path("api/v1/elm/", include("modules.elm.api.urls")),
    path("api/schema/", SpectacularAPIView.as_view(), name="schema"),
    path("api/docs/", SpectacularSwaggerView.as_view(url_name="schema"), name="docs"),
]
```

#### Register Module in Access Control

Run the seed_modules command to register the ELM module:

```bash
python manage.py seed_modules
```

### Step 2: Set Up the Frontend

Create a `client/src/modules/elm` directory and add the necessary components:

#### Create Components

Create a `LeaveApplicationForm.tsx` component for leave application submission:

```tsx
// client/src/modules/elm/components/LeaveApplicationForm.tsx
import React, { useState } from 'react';
import { useAuth } from '../auth/AuthProvider';

const LeaveApplicationForm: React.FC = () => {
  const [leaveType, setLeaveType] = useState('CL');
  const [startDate, setStartDate] = useState('');
  const [endDate, setEndDate] = useState('');
  const [stationLeave, setStationLeave] = useState(false);
  const { user } = useAuth();

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    // Call API to submit leave application
  };

  return (
    <form onSubmit={handleSubmit}>
      <label>
        Leave Type:
        <select value={leaveType} onChange={(e) => setLeaveType(e.target.value)}>
          <option value="CL">Casual Leave</option>
          <option value="RH">Recess Half</option>
          {/* Add other leave types */}
        </select>
      </label>
      <label>
        Start Date:
        <input type="date" value={startDate} onChange={(e) => setStartDate(e.target.value)} />
      </label>
      <label>
        End Date:
        <input type="date" value={endDate} onChange={(e) => setEndDate(e.target.value)} />
      </label>
      <label>
        Station Leave:
        <input type="checkbox" checked={stationLeave} onChange={(e) => setStationLeave(e.target.checked)} />
      </label>
      <button type="submit">Submit</button>
    </form>
  );
};

export default LeaveApplicationForm;
```

