### Step 5: Implement Frontend Components for Leave Balance Tracking

Create a `LeaveBalanceDashboard.tsx` component to display leave balances:

```tsx
// client/src/modules/elm/components/LeaveBalanceDashboard.tsx
import React, { useEffect, useState } from 'react';
import { useAuth } from '../auth/AuthProvider';

const LeaveBalanceDashboard: React.FC = () => {
  const [leaveBalances, setLeaveBalances] = useState([]);
  const { user } = useAuth();

  useEffect(() => {
    // Fetch leave balances data from API
    fetch(`/api/v1/elm/leavebalance/`)
      .then(response => response.json())
      .then(data => setLeaveBalances(data));
  }, [user]);

  return (
    <div>
      <h2>Leave Balance</h2>
      <table>
        <thead>
          <tr>
            <th>User</th>
            <th>Leave Type</th>
            <th>Balance</th>
          </tr>
        </thead>
        <tbody>
          {leaveBalances.map(balance => (
            <tr key={balance.id}>
              <td>{balance.user.name}</td>
              <td>{balance.leave_type}</td>
              <td>{balance.balance}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
};

export default LeaveBalanceDashboard;
```

