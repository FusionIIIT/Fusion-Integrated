import { useAuth } from '../auth/AuthProvider';

const AppShellLayout: React.FC = ({ children }) => {
  const { user } = useAuth();

  return (
    <div>
      {/* Navigation bar */}
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/directory">Directory</a></li>
          <li><a href="/placement">Placement</a></li>
          {user && user.permissions.includes('elm_access') && (
            <li><a href="/elm">ELM</a></li>
          )}
        </ul>
      </nav>
      {/* Main content */}
      <main>{children}</main>
    </div>
  );
};

export default AppShellLayout;
```

#### Role-Based UI

Ensure that the components are only accessible to users with the appropriate permissions:

```tsx
// client/src/modules/elm/components/LeaveApplicationForm.tsx
import React from 'react';
import { useAuth } from '../auth/AuthProvider';

const LeaveApplicationForm: React.FC = () => {
