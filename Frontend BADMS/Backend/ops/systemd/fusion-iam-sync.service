[Unit]
Description=Project ERP identity into the IAM
After=network.target postgresql.service

[Service]
Type=oneshot
User=fusion
Group=fusion
WorkingDirectory=/home/fusion/Fusion_System_Administrator/Backend/backend
ExecStart=/home/fusion/Fusion_System_Administrator/venv/bin/python manage.py sync_identity
# A mass deactivation is refused rather than applied; the run fails and the
# next tick retries, which is the safe way round.
Restart=no
